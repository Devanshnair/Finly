# ==============================================================================
# Finly — Environment Configuration
# ==============================================================================
# Note: Finly is completely self-contained and zero-credential out of the box!
# No external database credentials, third-party authentication tokens, or paid 
# API keys are required to build, run, or deploy.
#
# All variables below are entirely OPTIONAL:
# ==============================================================================


# Server port (default: 3000)
PORT=3000

# Canonical base URL for production deployments (used for OpenGraph/metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode (production / development / test)
NODE_ENV=development
